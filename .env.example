# MongoDB Atlas (required for contact form)
# Put the database name in the URI path (here: "portfolio").
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# Admin auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace_with_a_long_random_string

# Media Worker (server-only — never expose WORKER_SECRET to the browser)
# Local: http://127.0.0.1:8787  |  Deployed: https://media-worker.<account>.workers.dev
MEDIA_WORKER_URL=http://127.0.0.1:8787
WORKER_SECRET=replace_with_same_secret_as_wrangler_secret
# Public R2 base URL (r2.dev or custom domain). Used to build URLs from stored keys.
MEDIA_BASE_URL=https://pub-REPLACE.r2.dev

# Optional: notify your inbox after each submission (https://resend.com)
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
