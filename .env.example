# MongoDB Atlas (required for contact form)
# Put the database name in the URI path (here: "portfolio").
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/portfolio?retryWrites=true&w=majority

# Optional: notify your inbox after each submission (https://resend.com)
# RESEND_API_KEY=re_xxx
# CONTACT_TO_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
